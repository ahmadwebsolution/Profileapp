rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: only authenticated users can access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Notes subcollection: only authenticated users can access their own notes
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
